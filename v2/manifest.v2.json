{
  "manifest_version": 3,
  "name": "LinkedEmpire V2",
  "version": "0.1.0",
  "description": "LinkedEmpire v2 modular extension scaffold.",
  "permissions": ["alarms", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://app.linkedempire.com/*",
    "https://app.linkdominator.com/*"
  ],
  "background": {
    "service_worker": "src/service-worker/index.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content/index.js", "src/ui/shell.js"],
      "run_at": "document_idle"
    }
  ]
}
