{
   "action": {
      "default_icon": {
         "128": "/images/logo-1.png",
         "16": "/images/logo-1.png",
         "32": "/images/logo-1.png",
         "48": "/images/logo-1.png"
      }
   },
   "background": {
      "service_worker": "service-worker.js"
   },
   "content_scripts": [ {
      "css": [ "css/ld-scoped.css" ],
      "js": [
         "env.js",
         "js/ldRoot.js",
         "js/library/jquery.js",
         "js/ldJqueryPatch.js",
         "js/linkedinCompat.js",
         "js/v2/outreach.js",
         "js/appConfig.js",
         "js/mainMenu.js",
         "js/v2/ui/icons.js",
         "js/v2/ui/core/le2-core.js",
         "js/v2/ui/core/le2-panel-runner.js",
         "js/v2/ui/features/action-registry.js",
         "js/v2/ui/features/action-modal.js",
         "js/v2/ui/features/panels/audience-hub.js",
         "js/v2/ui/features/panels/audience-create-menu.js",
         "js/v2/ui/features/panels/audience-build.js",
         "js/v2/ui/features/panels/audience-import-url.js",
         "js/v2/ui/features/panels/audience-manage.js",
         "js/v2/ui/features/panels/campaign-hub.js",
         "js/v2/ui/features/panels/withdraw-invites.js",
         "js/v2/ui/features/panels/bulk-message.js",
         "js/v2/ui/features/panels/bulk-profile.js",
         "js/v2/ui/features/panels/add-connection.js",
         "js/v2/ui/features/panels/open-connect.js",
         "js/v2/ui/features/panels/accept-invites.js",
         "js/v2/ui/features/panels/message-followup.js",
         "js/v2/ui/tabs/actions.js",
         "js/v2/le2-app.js",
         "js/v2/ui/ld-brand.js",
         "js/v2/accountUi.js",
         "js/content-scripts/linkedinFeedCommentGenerator.js"
      ],
      "matches": [ "https://www.linkedin.com/*" ],
      "run_at": "document_idle",
      "all_frames": false
   } ],
   "description": "LinkedEmpire - LinkedIn automation tool. Automate connections, messages, and campaigns to grow your network.",
   "host_permissions": [
      "*://*.linkedin.com/*",
      "https://www.linkedin.com/*",
      "https://app.linkdominator.com/*",
      "https://linkedempire.com/*",
      "https://app.linkedempire.com/*",
      "https://*.linkedempire.com/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
   ],
   "icons": {
      "128": "/images/logo-1.png",
      "16": "/images/logo-1.png",
      "32": "/images/logo-1.png",
      "48": "/images/logo-1.png"
   },
   "manifest_version": 3,
   "name": "LinkedEmpire",
   "permissions": [ "alarms", "storage", "cookies", "activeTab", "scripting" ],
   "web_accessible_resources": [ {
      "resources": [ "images/*" ],
      "matches": [ "https://www.linkedin.com/*" ]
   } ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.5.9"
}
